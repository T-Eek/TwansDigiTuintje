.ShowCaseContainer { /*https://www.w3schools.com/css/css3_images.asp */
  display: flex;
  justify-content: space-evenly;
  align-items: center;
  margin: 1rem 0px;
  overflow-x: scroll;
  width: 100%;

}

.WorkShowCase1, .WorkShowCase2, .WorkShowCase3, .WorkShowCase4, .WorkShowCase5 {
  transition: padding 5s, box-shadow 5s;
}

.WorkShowCase3 {
  border-right: var(--border-right);
  border-left: var(--border-left);
  margin: 0px 1%;
}

.WorkShowCase1:hover, .WorkShowCase2:hover, .WorkShowCase4:hover, .WorkShowCase5:hover {
  box-shadow: 0rem 0rem 5rem var(--Custom-ColorG);
  cursor: pointer;

  .ShowCaseText{
    transition: 0.4s ease-in-out;
    color: var(--Custom-ColorC);
  }

  .ShowCaseText2 {
    transition: 0.4s ease-in-out;
    color: var(--Custom-Standaard-Color);
  }

    .ShowCaseText3 {
    transition: 0.4s ease-in-out;
    color: var(--Custom-ColorY);
  }

    .ShowCaseText4 {
    transition: 0.4s ease-in-out;
    background: linear-gradient(to bottom, var(--Border-bottom-CustumB) 40%, var(--Boder-bottom-CustomY) 60%);
    background-clip: text;
    color: transparent;
    text-shadow: none;
  }

  .ShowCaseText5 {
    background-image: linear-gradient(to right, #405de6, #5851db, #833ab4, #c13584, #e1306c, #fd1d1d,#f56040, #f77737, #fcaf45, #ffdc80);
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: ShowCaseMove 360s linear infinite;
    cursor: pointer;
  }
}

